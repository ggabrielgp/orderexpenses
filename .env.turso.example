# Order Expenses — Turso-only values example
# Useful when running locally against the remote Turso DB.

TURSO_DATABASE_URL=libsql://replace-with-your-db-name-replace-with-org.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-db-token

# Keep local server values if testing remote DB from your machine.
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:3000
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
COOKIE_SECURE=false
