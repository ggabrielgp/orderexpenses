# Order Expenses — local development example
# Copy this file to .env and replace values as needed.

# Local server
PORT=3000
HOST=127.0.0.1
APP_BASE_URL=http://127.0.0.1:3000

# Local database fallback. If TURSO_DATABASE_URL is empty, libSQL uses this local file.
DB_PATH=data/finance.db
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Local Gmail OAuth option A: use downloaded Google credentials JSON.
GOOGLE_CREDENTIALS_PATH=data/google-credentials.json
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback

# Local Gmail OAuth option B: use env vars instead of JSON.
# GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Session cookie
SESSION_COOKIE_NAME=finance_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=false

# Do not set this locally unless exposing the app outside localhost/127.0.0.1.
# ALLOW_UNSAFE_HOST=true
