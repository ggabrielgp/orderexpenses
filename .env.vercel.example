# Order Expenses — Vercel production/preview env example
# Add these in Vercel Project Settings → Environment Variables.
# Do not commit real values.

NODE_ENV=production

# Public deployed URL. Replace after creating/importing the Vercel project.
APP_BASE_URL=https://replace-with-your-vercel-domain.vercel.app

# Turso / libSQL
TURSO_DATABASE_URL=libsql://replace-with-your-db-name-replace-with-org.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-db-token

# Google OAuth web client
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://replace-with-your-vercel-domain.vercel.app/auth/google/callback

# Cookies
SESSION_COOKIE_NAME=finance_session
SESSION_TTL_DAYS=30
COOKIE_SECURE=true

# Serverless/public host guard.
# Required only if the Node server path is used behind a non-loopback host.
ALLOW_UNSAFE_HOST=true
